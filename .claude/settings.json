{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)",
      "Bash(pio run -t upload:*)",
      "Bash(esptool:*)",
      "Bash(idf.py flash:*)",
      "Bash(arduino-cli upload:*)",
      "Read(./.env)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
